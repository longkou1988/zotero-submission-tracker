{
  "name": "zotero-submission-tracker",
  "type": "module",
  "version": "0.5.0",
  "description": "Track journal submission records for your manuscripts in Zotero. 在 Zotero 中跟踪论文投稿记录。",
  "config": {
    "addonName": "Submission Tracker",
    "addonID": "submission-tracker@research-tools",
    "addonRef": "submissiontracker",
    "addonInstance": "SubmissionTracker",
    "prefsPrefix": "extensions.zotero.submissiontracker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longkou1988/zotero-submission-tracker.git"
  },
  "author": "kouzi",
  "bugs": {
    "url": "https://github.com/longkou1988/zotero-submission-tracker/issues"
  },
  "homepage": "https://github.com/longkou1988/zotero-submission-tracker#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "node --test scripts/*.test.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "zotero-plugin-scaffold": "^0.8.2"
  }
}
